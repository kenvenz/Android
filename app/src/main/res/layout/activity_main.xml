<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="197dp"
        app:srcCompat="@drawable/marca" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Análise e Desenvolvimento de Sistemas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Curso voltado para desenvolvimento de sistemas, aplicativos e soluções tecnológicas."
        android:textSize="17sp"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnConheca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONHEÇA O CURSO"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/btnDisciplinas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DISCIPLINAS"
        android:layout_marginTop="10dp" />

</LinearLayout>
