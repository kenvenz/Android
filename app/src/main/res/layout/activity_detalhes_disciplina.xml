<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="#000000">

        <TextView
            android:layout_width="385dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-140dp"
            android:layout_marginBottom="25dp"
            android:gravity="center"
            android:text="DETALHES DA DISCIPLINA"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNomeDisciplina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Nome da disciplina"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCargaHoraria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carga horária: 80 horas"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="10dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtModalidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modalidade: Presencial"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="10dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtProfessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Professor: Leandro Melo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="10dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nível: Intermediário"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="10dp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição:"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da disciplina"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="10dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="COMPARTILHAR"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnVoltarDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="VOLTAR"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>